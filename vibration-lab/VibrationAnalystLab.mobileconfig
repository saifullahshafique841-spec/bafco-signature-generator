	<key>PayloadDescription</key>
	<string>Adds the Vibration Analyst Lab icon to your Home Screen. The lab opens full screen like an app and keeps working offline. Nothing else on your iPhone is changed. To remove it, delete the icon or the profile (Settings, General, VPN &amp; Device Management).</string>
	<key>PayloadDisplayName</key>
	<string>Vibration Analyst Lab</string>
	<key>PayloadIdentifier</key>
